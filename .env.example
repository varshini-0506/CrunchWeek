# ---------- web (Next.js) -> put these in web/.env.local ----------
# URL of the Python engine service
ENGINE_URL=http://localhost:8000
# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me
# Optional shared secret between web and engine (set the same value on both)
ENGINE_TOKEN=
# Supabase project (Project Settings > API and > Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---------- engine (FastAPI) -> environment of the engine process ----------
CORS_ORIGINS=http://localhost:3000
ENGINE_TOKEN=
# Claude API key for the optional AI layer. Without it the rule-based parser is used.
ANTHROPIC_API_KEY=
# "off" forces AI-off mode even when a key is set
AI_MODE=on
# Optional overrides
DATASET_PATH=../data/cit_public.json
SOLVE_SECONDS=60
REPAIR_SECONDS=45
