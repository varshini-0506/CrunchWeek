# ---------- web (Next.js) ----------
# URL of the Python engine service
ENGINE_URL=http://localhost:8000
# Supabase project (Project Settings > API and > Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string from Supabase (used by the engine and migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Auth.js secret, generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
# Claude API key for the AI assistant (the app works without it; AI features switch off)
ANTHROPIC_API_KEY=
# Set to "off" to force AI-off mode
AI_MODE=on

# ---------- engine (FastAPI) ----------
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Optional: path to the dataset file the engine loads on start and on reset
DATASET_PATH=../data/cit_public.json
